# Copy to .env.local for local work. Never commit real values to .env.example.
# These three values are PUBLIC by design (they are baked into the browser bundle).
# NEVER put the Supabase service-role key here or anywhere in this repository.

# Supabase project URL, e.g. https://abcdefgh.supabase.co  (leave empty to use FAKE sample data in `npm run dev` only)
VITE_SUPABASE_URL=
# Supabase "anon" public key
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (used from Stage 3)
VITE_TURNSTILE_SITE_KEY=
